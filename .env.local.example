# ==========================================================
# .env.local.example  —  TEMPLATE. Safe to commit.
# ==========================================================
# Teammates: copy this file to `.env.local` and fill in your
# OWN values. `.env.local` is gitignored and must never be
# committed. Never put real tokens in THIS file.
#
#   cp .env.local.example .env.local
# ==========================================================

# GitHub fine-grained personal access token (starts with github_pat_)
# Create at: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Add other course/project keys below as needed, e.g.:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
